<div class="layout layout--col layout--top gap--small lg:gap--medium">
{% render 'hero', headline: headline, window: window, found: found, date: date, risk: risk, temperature: temperature, wind: wind, detail: detail, size: 'value--large lg:value--xlarge', expanded: true %}
{% if ribbon %}
{% render 'weather_ribbon', ribbon: ribbon %}
{% endif %}
<div class="w--full">
  <span class="label label--small 1bit:text--black">{{ updated | escape }} · {{ zone | escape }} · Open-Meteo (CC BY 4.0)</span>
</div>
</div>
{% render 'title_bar', location: location %}
