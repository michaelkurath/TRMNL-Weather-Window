<div class="layout layout--col layout--top gap--small">
  <div class="flex flex--row gap--medium w--full">
    {% render 'hero', headline: headline, window: window, found: found, date: date, risk: risk, temperature: temperature, wind: wind, detail: detail, size: 'value--medium lg:value--large' %}
