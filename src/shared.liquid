{% template title_bar %}
<div class="title_bar"><span class="title">Weather Window</span><span class="instance">{{ location | escape }}</span></div>
{% endtemplate %}
{% template hero %}
<div class="flex flex--col gap--small w--full">
  <span class="label label--small {% if expanded %}lg:text--large{% endif %} 1bit:text--black">{{ headline | escape }}</span>
  <span class="value {{ size }}">{{ window | escape }}</span>
  {% if found %}
  <span class="label">{{ date | escape }} · {{ risk | escape }}</span>
  <span class="description {% if expanded %}lg:text--large{% endif %}">{{ temperature | escape }} · {{ wind | escape }}</span>
  {% endif %}
  <span class="label label--small 1bit:text--black">{{ detail | escape }}</span>
</div>
{% endtemplate %}
{% template timeline %}
<div class="flex flex--col gap--small w--full">
  <span class="label label--small 1bit:text--black">{% if expanded %}HOURLY OUTLOOK · Rain probability · Filled = likely dry{% else %}HOURLY OUTLOOK · Rain probability{% endif %}</span>
  <div class="grid grid--cols-{{ columns | default: count }} {% if expanded %}gap--medium lg:gap--large{% else %}gap--small{% endif %} w--full">
  {% for hour in hours limit:count %}
    <div class="flex flex--col gap--xsmall">
      <span class="label label--small 1bit:text--black">{{ hour.day | escape }}</span>
      <span class="label label--small {% if expanded %}lg:text--large{% endif %} 1bit:text--black">{{ hour.time | escape }}</span>
      {% if expanded %}
      <span class="label {% if hour.dry %}label--inverted{% else %}label--outline{% endif %} text--large lg:text--xlarge">{{ hour.probability | escape }}</span>
      <span class="label lg:text--large">{{ hour.temperature | escape }}</span>
      {% unless hour.dry %}<span class="label label--small 1bit:text--black">{{ hour.label | escape }}</span>{% endunless %}
      {% else %}
      <span class="label {% if hour.dry %}label--inverted{% else %}label--outline{% endif %}">{{ hour.label | escape }}</span>
      <span class="label">{{ hour.probability | escape }}</span>
      <span class="label label--small 1bit:text--black">{{ hour.temperature | escape }}</span>
      {% endif %}
    </div>
  {% endfor %}
  </div>
</div>
{% endtemplate %}
<style>
.ww-footnote { position: absolute; bottom: 38px; left: 16px; right: 16px; font-size: 12px; color: #000; }
</style>
