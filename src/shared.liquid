{% template title_bar %}
<div class="title_bar"><span class="title">Weather Window</span><span class="instance">{{ location | escape }}</span></div>
{% endtemplate %}
{% template hero %}
<div class="flex flex--col gap--small w--full">
  <span class="label label--small {% if expanded %}lg:text--large{% endif %} 1bit:text--black">{{ headline | escape }}</span>
  <span class="value {{ size }}">{{ window | escape }}</span>
  {% if found %}
  <span class="label">{{ date | escape }} · {{ risk | escape }}</span>
  <span class="description {% if expanded %}lg:text--large{% endif %}">{{ temperature | escape }} · {{ wind | escape }}</span>
  {% endif %}
  <span class="label label--small 1bit:text--black">{{ detail | escape }}</span>
</div>
{% endtemplate %}
{% template timeline %}
<div class="flex flex--col gap--small w--full">
  <span class="label label--small 1bit:text--black">{% if expanded %}HOURLY OUTLOOK · Rain probability · Filled = likely dry{% else %}HOURLY OUTLOOK · Rain probability{% endif %}</span>
  <div class="grid grid--cols-{{ columns | default: count }} {% if expanded %}gap--medium lg:gap--large{% else %}gap--small{% endif %} w--full">
  {% for hour in hours limit:count %}
    <div class="flex flex--col gap--xsmall">
      <span class="label label--small 1bit:text--black">{{ hour.day | escape }}</span>
      <span class="label label--small {% if expanded %}lg:text--large{% endif %} 1bit:text--black">{{ hour.time | escape }}</span>
      {% if expanded %}
      <span class="label {% if hour.dry %}label--inverted{% else %}label--outline{% endif %} text--large lg:text--xlarge">{{ hour.probability | escape }}</span>
      <span class="label lg:text--large">{{ hour.temperature | escape }}</span>
      {% unless hour.dry %}<span class="label label--small 1bit:text--black">{{ hour.label | escape }}</span>{% endunless %}
      {% else %}
      <span class="label {% if hour.dry %}label--inverted{% else %}label--outline{% endif %}">{{ hour.label | escape }}</span>
      <span class="label">{{ hour.probability | escape }}</span>
      <span class="label label--small 1bit:text--black">{{ hour.temperature | escape }}</span>
      {% endif %}
    </div>
  {% endfor %}
  </div>
</div>
{% endtemplate %}
{% template compact_meta %}
<span class="label label--small 1bit:text--black">{{ updated | escape }} · {{ zone | escape }} · Open-Meteo</span>
{% endtemplate %}

{% template weather_ribbon %}
<svg class="ww-ribbon" viewBox="0 0 960 300" role="img" aria-label="Hourly temperature and rain probability. The highlighted region is the next likely dry window; dotted regions are night.">
  <defs>
    <pattern id="ww-night" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.15" fill="#777"/></pattern>
  </defs>
  <text x="40" y="18" font-size="15" font-weight="600" letter-spacing="1">{{ ribbon.range | escape }}</text>
  {% for band in ribbon.nights %}<rect x="{{ band.x }}" y="31" width="{{ band.width }}" height="229" fill="url(#ww-night)"/>{% endfor %}
  <line x1="40" y1="171" x2="920" y2="171" stroke="#999" stroke-width="1"/>
  <text x="40" y="88" font-size="14" font-weight="600" letter-spacing="1">TEMP</text>
  <text x="40" y="190" font-size="14" font-weight="600" letter-spacing="1">RAIN</text>
  <line x1="40" y1="260" x2="920" y2="260" stroke="black" stroke-width="1"/>
  {% for bar in ribbon.bars %}
    {% if bar.unknown %}<text x="{{ bar.x }}" y="250" font-size="16">?</text>
    {% else %}<rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" fill="black"/>{% endif %}
  {% endfor %}
  <path d="{{ ribbon.path }}" fill="none" stroke="black" stroke-width="3.5" stroke-linejoin="round"/>
  {% for tick in ribbon.labels %}
    {% unless tick.icon == 'none' %}<g transform="translate({{ tick.x }}, 51)" fill="white" stroke="black" stroke-width="2">
    {% if tick.icon == 'sun' %}
    <circle cx="0" cy="0" r="8"/><path d="M0 -16v4M0 12v4M-16 0h4M12 0h4M-11 -11l3 3M8 8l3 3M-11 11l3 -3M8 -8l3 -3"/>
    {% elsif tick.icon == 'unknown' %}
    <text x="0" y="6" text-anchor="middle" fill="black" stroke="none" font-size="20">?</text>
    {% else %}
    <path d="M-13 5C-22 3 -20 -8 -11 -8C-10 -19 7 -19 9 -7C22 -9 24 6 13 6Z"/>
    {% if tick.icon == 'rain' %}<path d="M-9 11l-3 6M1 11l-3 6M11 11l-3 6"/>{% endif %}
    {% if tick.icon == 'storm' %}<path d="M2 9l-7 9h6l-5 8" fill="none"/>{% endif %}
    {% if tick.icon == 'snow' %}<path d="M0 10v14M-6 13l12 8M6 13l-12 8"/>{% endif %}
    {% endif %}
    </g>{% endunless %}
    <text x="{{ tick.x }}" y="{{ tick.ty }}" text-anchor="middle" font-size="17">{{ tick.temperature | escape }}</text>
    <text x="{{ tick.x }}" y="285" text-anchor="middle" font-size="17">{{ tick.time }}</text>
  {% endfor %}
  {% for marker in ribbon.dayMarkers %}<text x="{{ marker.x }}" y="299" text-anchor="start" font-size="13" font-weight="600">{{ marker.label | upcase | escape }}</text>{% endfor %}
  {% if ribbon.nowX %}
    <line x1="{{ ribbon.nowX }}" y1="31" x2="{{ ribbon.nowX }}" y2="260" stroke="black" stroke-width="1.5" stroke-dasharray="5 5"/>
    <rect x="{{ ribbon.nowX | minus: 22 }}" y="25" width="44" height="19" rx="3" fill="black"/>
    <text x="{{ ribbon.nowX }}" y="39" text-anchor="middle" font-size="12" font-weight="700" fill="white">NOW</text>
  {% endif %}
  {% if ribbon.selection %}
    <rect x="{{ ribbon.selection.x }}" y="31" width="{{ ribbon.selection.width }}" height="229" rx="5" fill="white" fill-opacity="0.18" stroke="black" stroke-width="2.5"/>
    <rect x="{{ ribbon.selection.x }}" y="31" width="{{ ribbon.selection.width }}" height="9" rx="4" fill="black"/>
  {% endif %}
</svg>
{% endtemplate %}
<style>
.ww-ribbon { display: block; width: 100%; height: auto; flex-shrink: 1; min-height: 0; font-family: inherit; color: #000; }
</style>

{% template weather_strip %}
<svg class="ww-strip{% if compact %} ww-strip--compact{% endif %}" viewBox="0 0 960 {% if compact %}170{% else %}200{% endif %}" role="img" aria-label="Compact hourly temperature and rain outlook. The outlined region is the next window.">
  <defs>
    <pattern id="ww-strip-night" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M0 10L10 0" stroke="#999" stroke-width="1"/></pattern>
  </defs>
  {% for band in ribbon.nights %}<rect x="{{ band.x }}" y="12" width="{{ band.width }}" height="158" fill="url(#ww-strip-night)"/>{% endfor %}
  <text x="42" y="28" font-size="18">TEMP</text>
  <path d="{{ ribbon.path }}" transform="translate(0,-70)" fill="none" stroke="black" stroke-width="5"/>
  <text x="42" y="112" font-size="18">RAIN</text>
  <line x1="40" y1="170" x2="920" y2="170" stroke="black" stroke-width="2"/>
  <g transform="translate(0,-90)">
  {% for bar in ribbon.bars %}
    {% if bar.unknown %}<text x="{{ bar.x }}" y="250" font-size="24">?</text>
    {% else %}<rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" fill="black"/>{% endif %}
  {% endfor %}
  </g>
  {% if ribbon.selection %}<rect x="{{ ribbon.selection.x }}" y="10" width="{{ ribbon.selection.width }}" height="162" rx="7" fill="none" stroke="black" stroke-width="5"/>{% endif %}
  {% unless compact %}
  {% for tick in ribbon.labels %}<text x="{{ tick.x }}" y="196" text-anchor="middle" font-size="20">{{ tick.time | escape }}</text>{% endfor %}
  {% endunless %}
</svg>
{% endtemplate %}
<style>
.ww-strip { display: block; width: 100%; height: auto; min-width: 0; flex-shrink: 1; font-family: inherit; color: #000; }
.ww-strip--compact { max-height: 72px; }
.ww-compact-meta { width: 100%; }
</style>

<style>
.title_bar .instance { max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>

{% template editorial_hero %}
<div class="ww-small-hero">
  <div class="ww-small-eyebrow">{{ headline | escape }}</div>
  <div class="ww-small-time{% unless found %} ww-small-time--message{% endunless %}">{{ window | escape }}</div>
  {% if found %}
    <div class="ww-small-date">{{ date | escape }} · {{ risk | escape }}</div>
    {% unless minimal %}<div class="ww-small-weather">{{ temperature | escape }} · {{ wind | escape }}</div>{% endunless %}
  {% endif %}
  {% unless minimal and found %}<div class="ww-small-reason">{{ detail | escape }}</div>{% endunless %}
</div>
{% endtemplate %}

{% template editorial_strip %}
<svg class="ww-editorial-strip" viewBox="0 0 960 {% if minimal %}220{% else %}285{% endif %}" preserveAspectRatio="none" role="img" aria-label="{% if minimal %}Hourly rain probability{% else %}Hourly temperature and rain probability{% endif %}. Top black rail marks the likely dry window.">
  <text x="40" y="28" font-size="30" font-weight="700">{% if found %}LIKELY DRY{% else %}OUTLOOK{% endif %}</text>
  <line x1="40" y1="46" x2="920" y2="46" stroke="black" stroke-width="2"/>
  {% if ribbon.selection %}<rect x="{{ ribbon.selection.x }}" y="40" width="{{ ribbon.selection.width }}" height="12" rx="6" fill="black"/>{% endif %}
  {% unless minimal %}
  <text x="40" y="83" font-size="28" font-weight="700">TEMP</text>
  <path d="{{ ribbon.path }}" transform="translate(0,-15)" fill="none" stroke="black" stroke-width="5"/>
  {% endunless %}
  <text x="40" y="{% if minimal %}90{% else %}158{% endif %}" font-size="28" font-weight="700">RAIN %</text>
  <g transform="translate(0,{% if minimal %}-90{% else %}-35{% endif %})">
  {% for bar in ribbon.bars %}
    {% if bar.unknown %}<text x="{{ bar.x }}" y="254" font-size="32">?</text>
    {% else %}<rect x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}" fill="black"/>{% endif %}
  {% endfor %}
  </g>
  <line x1="40" y1="{% if minimal %}170{% else %}225{% endif %}" x2="920" y2="{% if minimal %}170{% else %}225{% endif %}" stroke="black" stroke-width="2"/>
  {% for tick in ribbon.labels %}
    {% assign alternate = forloop.index0 | modulo: 2 %}
    {% if alternate == 0 %}
      <text x="{{ tick.x }}" y="{% if minimal %}199{% else %}254{% endif %}" text-anchor="middle" font-size="32">{{ tick.time }}</text>
      <text x="{{ tick.x }}" y="{% if minimal %}220{% else %}279{% endif %}" text-anchor="middle" font-size="25">{{ tick.day }}</text>
    {% endif %}
  {% endfor %}
</svg>
{% endtemplate %}
<style>
.ww-small { container-type:inline-size; display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start; padding:12px 14px 8px; gap:8px; color:#000; font-family:Arial,Helvetica,sans-serif; }
.ww-small-eyebrow { font-size:13px; font-weight:700; }
.ww-small-time { font-size:38px; line-height:1.08; font-weight:700; letter-spacing:-1px; margin:3px 0 6px; white-space:nowrap; }
.ww-small-time--message { font-size:25px; white-space:normal; overflow-wrap:break-word; }
.ww-small-date { font-size:13px; line-height:1.3; }
.ww-small-weather { font-size:15px; line-height:1.4; margin-top:7px; }
.ww-small-reason { font-size:13px; line-height:1.3; margin-top:7px; }
.ww-small-source { margin-top:auto; font-size:10px; line-height:1.2; }
.ww-small-body { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24px; align-items:start; }
.ww-small-chart { min-width:0; width:100%; border-top:1px solid #000; padding-top:6px; }
.ww-editorial-strip { display:block; width:100%; height:128px; font-family:Arial,Helvetica,sans-serif; overflow:visible; }
.ww-small--horizontal .ww-small-weather { font-size:13px; margin-top:4px; }
.ww-small--vertical .ww-small-time { font-size:44px; }
.ww-small--vertical .ww-small-time--message { font-size:29px; }
.ww-small--vertical .ww-small-chart { margin-top:8px; }
.ww-small--vertical .ww-editorial-strip { height:165px; }
.ww-small--quadrant { gap:5px; padding:8px 12px 6px; }
.ww-small--quadrant .ww-small-time { font-size:32px; margin:2px 0 4px; }
.ww-small--quadrant .ww-small-time--message { font-size:23px; }
.ww-small--quadrant .ww-small-date { font-size:12px; }
.ww-small--quadrant .ww-small-reason { font-size:12px; margin-top:4px; }
.ww-small--quadrant .ww-editorial-strip { height:66px; }
@container(min-width:450px) {
  .ww-small--vertical .ww-small-time { font-size:56px; }
  .ww-small--vertical .ww-small-time--message { font-size:36px; }
  .ww-small--vertical .ww-editorial-strip { height:220px; }
  .ww-small--quadrant .ww-small-time { font-size:40px; }
  .ww-small--quadrant .ww-small-time--message { font-size:27px; }
  .ww-small--quadrant .ww-editorial-strip { height:100px; }
}
</style>
